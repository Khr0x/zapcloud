[server]
listen = "127.0.0.1:9000"
region = "local-1"

[storage]
metadata = "sqlite://./data/zapcloud.db"
artifacts = "./data/artifacts"
# Raíz de los runtime bundles (§16/§17), generados con `xtask bundle`.
runtimes = "./runtimes"

[security]
tenant_trust = "trusted"

[executor]
default = "process"

[auth]
mode = "none"
# Sin autenticación solo se permite loopback (127.0.0.0/8 o ::1).
# true permite ejecutar código sin autenticación desde la red: solo laboratorio aislado.
allow_insecure_non_loopback = false

[telemetry]
prometheus = true

# Distribución de runtime bundles (§17). La cache vive en `storage.runtimes`.
[runtimes]
# Registry OCI base documentado para los bundles publicados.
# Nota: hasta v0.1.2 la autoridad efectiva es `oci_ref` de runtimes/index.json;
# este campo aún no altera el origen de descarga.
registry = "ghcr.io/khr0x/zapcloud"
# Runtimes a asegurar en el preflight de `serve` (si ensure_on_start = true).
preinstall = []
# Bajar los `preinstall` ausentes al arrancar `serve` (antes de escuchar).
ensure_on_start = false
# Nunca tocar la red: solo usar la cache local (`storage.runtimes`).
offline = false
